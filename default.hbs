<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <script>try{if(localStorage.getItem("wl_offer_bf_closed"))document.documentElement.classList.add("ribbon-closed")}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <meta name="color-scheme" content="light dark">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <meta name="format-detection" content="telephone=no">
    <meta name="application-name" content="{{@site.title}}">

    <link rel="icon" href="{{asset "icons/favicon.svg"}}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{asset "icons/apple-touch-icon.png"}}">

    <link rel="preload" href="{{asset "fonts/dm-sans-normal-latin.woff2"}}" as="font" type="font/woff2" crossorigin>

    {{!-- Preload feature image on single posts (LCP optimization) --}}
    {{#is "post"}}{{#post}}{{#if feature_image}}
    <link rel="preload" as="image"
          href="{{img_url feature_image size="m" format="webp"}}"
          imagesrcset="{{img_url feature_image size="xs" format="webp"}} 400w, {{img_url feature_image size="s" format="webp"}} 800w, {{img_url feature_image size="m" format="webp"}} 1200w"
          imagesizes="(max-width: 900px) 100vw, 560px"
          fetchpriority="high">
    {{/if}}{{/post}}{{/is}}

    {{!-- Ghost's meta_title: post/page SEO title (or title), author and tag names, Settings > meta title on home.
         No " - WizLeads" suffix on posts: it pushed most titles past 60 characters, and Google shows the site name separately. --}}
    <title>{{meta_title}}</title>

    {{!-- Theme stylesheet --}}
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">

    {{ghost_head}}
    {{!-- BreadcrumbList for posts: WizLeads > Blog > primary tag > post. {{title}} stays HTML-escaped so a quote in a title cannot break the JSON. --}}
    {{#is "post"}}{{#post}}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"WizLeads","item":"https://wizleads.io/"},{"@type":"ListItem","position":2,"name":"Blog","item":"{{@site.url}}/"},{{#if primary_tag}}{{#primary_tag}}{"@type":"ListItem","position":3,"name":"{{name}}","item":"{{url absolute="true"}}"},{{/primary_tag}}{"@type":"ListItem","position":4,"name":"{{title}}","item":"{{url absolute="true"}}"}{{else}}{"@type":"ListItem","position":3,"name":"{{title}}","item":"{{url absolute="true"}}"}{{/if}}]}</script>{{/post}}{{/is}}
</head>

<body class="{{body_class}}">
    <a class="skip-link" href="#main">Skip to content</a>

    {{> "header"}}

    <main id="main" tabindex="-1">
        {{{body}}}
    </main>

    {{> "footer"}}

    {{> "promo-popup"}}

    <script defer src="{{asset "js/theme.js"}}"></script>
    {{ghost_foot}}
</body>
</html>
